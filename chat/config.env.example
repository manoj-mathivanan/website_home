CHAT_ORIGIN=https://manojmathivanan.com
CHAT_STATE_DIR=/var/lib/home-chat
CHAT_PORT=8766
CHAT_RETENTION_DAYS=90
CHAT_NOTIFY_TO=ma.manoj@gmail.com
# Use a verified sender address with your email provider.
CHAT_EMAIL_FROM=
# Configure Resend OR SMTP. Keep actual secrets in /etc/home-chat.env only.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
