[Unit]
Description=Private resume chatbot backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=home-chat
Group=home-chat
WorkingDirectory=/opt/home
EnvironmentFile=/etc/home-chat.env
ExecStart=/usr/bin/python3 /opt/home/chat/server.py
Restart=on-failure
RestartSec=5
StateDirectory=home-chat
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
